PORT=3000
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
WEBSITE_URL=https://example.com
ALLOWED_ORIGINS=https://example.com,https://www.example.com
ADMIN_TOKEN=replace_with_a_long_random_secret_at_least_32_chars
SETTINGS_ENCRYPTION_KEY=replace_with_a_different_random_secret_at_least_32_chars
MAX_PAGES=200
MAX_CRAWL_DEPTH=4
INDEX_REFRESH_HOURS=24
TRUST_PROXY=false
CHAT_RATE_LIMIT=15
ADMIN_RATE_LIMIT=10
ADMIN_ALLOWED_IPS=
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_BOT_ID=boo
# Prefer GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json.
# Use this base64 fallback only when a mounted secret file is unavailable.
FIREBASE_SERVICE_ACCOUNT_BASE64=
